# Copy to .env.local and fill in. Never commit real values.

# --- Database (Supabase Postgres) ---
# Pooled connection (port 6543, pgbouncer) used at runtime
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by `prisma db push`
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (storage bucket "celea-media") ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Google AI (Gemini + Veo) ---
GOOGLE_AI_API_KEY=""
# Optional model overrides
# GEMINI_MODEL="gemini-3.8-flash"
# VEO_MODEL="veo-3.1-generate-preview"

# --- Invite gate ---
# Secret used to sign the invite cookie (required in production): openssl rand -hex 32
INVITE_SECRET=""
# Comma-separated list of valid 6-character invite codes
INVITE_CODES=""

# --- Admin waitlist API (/api/admin/waitlist) ---
ADMIN_API_KEY=""

# --- Inngest (production background jobs) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Set to "true" to use Inngest locally (with `npx inngest-cli dev`)
# USE_INNGEST="true"
